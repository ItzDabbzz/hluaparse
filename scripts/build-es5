#!/usr/bin/env node
// Build the ES5 distribution artifact.
//
// The source in luaparse.js is modern ES6: shorthand properties, template
// literals, let/const, arrow functions and array/object spread. Node, Bun
// and Rhino 1.9+ run it directly. The older embeddable engines that this
// parser is often dropped into -- Duktape 2.x, QuickJS 2020-2026, RingoJS
// and Rhino 1.7/1.8 -- are ES5-only and cannot even parse it.
//
// So those engines are tested against this downlevelled build instead. It is
// generated, never hand-edited, and the ES6 source remains the thing that is
// linted, complexity-checked, coverage-measured and published to npm-style
// consumers. This file exists purely so the legacy engine jobs have something
// they can actually load.
'use strict';

const esbuild = require('esbuild');
const path = require('path');
const fs = require('fs');

const root = path.join(__dirname, '..');
const outfile = path.join(root, 'dist', 'luaparse.es5.js');

fs.mkdirSync(path.dirname(outfile), { recursive: true });

esbuild.buildSync({
  entryPoints: [path.join(root, 'luaparse.js')],
  outfile,
  // The file is already a UMD module, so esbuild must only strip ES6 syntax.
  // Do not set `format`: any wrapper (iife, cjs, esm) re-wraps the entry and
  // swallows the `root[name]` assignment the UMD performs, leaving no global
  // for the script-loading engines to find. With no format the output keeps
  // the original UMD wrapper verbatim.
  target: 'es5',
  platform: 'neutral',
  legalComments: 'inline',
  banner: {
    js: '/* hluaparse - ES5 build. Generated by scripts/build-es5; do not edit.\n' +
        '   The ES6 source is luaparse.js. */'
  },
  logLevel: 'warning'
});

const bytes = fs.statSync(outfile).size;
process.stdout.write('built dist/luaparse.es5.js (' + bytes + ' bytes)\n');
